{
  "editor": {
    "show_horizontal_scrollbar": false,
    "menu_bar_mnemonics": false
  },
  "active_keybinding_map": "vscode",
  "file_browser": {
    "show_hidden": true
  },
  "file_explorer": {
    "show_gitignored": true,
    "show_hidden": true
  },
  "version": 2,
  "lsp": {
    "typescript": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": false
      }
    }
  },
  "plugins": {
    "vi_mode": {
      "enabled": true,
      "settings": {
        "autoStart": false,
        "arrowKeys": true,
        "searchWordUnderCursor": true
      }
    }
  }
}
