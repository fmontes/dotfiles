# This is Git's per-user configuration file.
[user]
	name = Your Name
	email = your@email.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
	line-numbers = true
	side-by-side = false
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[pull]
	rebase = true
[rebase]
	autoStash = true
[credential]
	helper = store

# Machine-local overrides (identity, work settings). Not tracked; see README.
[include]
	path = ~/.gitconfig.local
# Sign every commit and tag with an SSH key. The key itself and the allowed-
# signers file are absolute paths under $HOME, so they live in ~/.gitconfig.local
# with the identity -- see README. Without them `gpgsign = true` fails every
# commit, which is why a new machine has to set those two before committing.
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
