#!/usr/bin/env bash
#
# killport — kill whatever is listening on a port.
#
# Usage:
#   killport 3000
set -euo pipefail

usage() { awk 'NR>2 && /^#/ { sub(/^# ?/, ""); print; next } NR>2 { exit }' "$0"; }
[[ ${1:-} == "-h" || ${1:-} == "--help" || -z ${1:-} ]] && { usage; exit 0; }

pids=$(lsof -ti ":$1" || true)
if [[ -z $pids ]]; then
  echo "Nothing listening on port $1"
  exit 1
fi
echo "Killing PID(s) $(echo "$pids" | tr '\n' ' ')on port $1"
echo "$pids" | xargs kill -9
