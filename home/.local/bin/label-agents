#!/usr/bin/env python3
#
# label-agents — give every agent a short sidebar label, summarised by Haiku.
#
# herdr shows what an agent reports it is doing, which is already a sentence
# written by the agent: "Content types component imports dynamic migration".
# In a 26-column sidebar that truncates to "Content types component", losing
# the part that identified it. This summarises instead of truncating, so the
# same title reads "content types migration".
#
# Results are cached by title, so a title is summarised once no matter how
# often the agent reports it, and a run with no new titles costs nothing.
#
# Every machine in `herdr machine list` is labelled too, not just the local
# one. Remote agents share the sidebar with local ones, and a sidebar where
# only half the rows carry a label is worse than one where none do.
#
# Usage:
#   label-agents           label every agent that needs it
#   label-agents --force   re-summarise even cached titles
#   label-agents --clear   remove every label this tool set

import json
import os
import re
import subprocess
import sys
from pathlib import Path

SOURCE = "agent-label"
TOKEN = "label"
# Set only for agents on another machine, so the sidebar can show where an
# agent lives without spending a row on the word "Local" nine times.
REMOTE_TOKEN = "remote"
MODEL = "claude-haiku-4-5-20251001"
CACHE = Path.home() / ".local/state/label-agents/cache.json"

# Titles this short are already labels. Sending them to a model costs a call
# and usually returns the same words back.
SHORT_ENOUGH = 24
MAX_WORDS = 3

# An agent that is mid-turn reports its state as its title. Summarising that
# gives every busy agent the label "working", and it sticks after the agent
# goes idle because the real title never gets re-read. Leave the old label
# alone instead.
STATUS_TITLES = {
    "working", "idle", "blocked", "waiting", "thinking", "done", "running",
    "ready", "error", "unknown",
}

SYSTEM = (
    "You shorten terminal tab labels. You receive a JSON array of strings and "
    "return a JSON array of the same length, same order, where each element is "
    "that string shortened to at most 3 words, lowercase, no punctuation. "
    "Output ONLY the JSON array. Never ask a question. Never answer the text, "
    "only compress it."
)

if "--help" in sys.argv or "-h" in sys.argv:
    print("\n".join(l[2:] if l.startswith("# ") else l[1:]
                    for l in Path(__file__).read_text().splitlines()[2:] if l.startswith("#")))
    raise SystemExit(0)

FORCE = "--force" in sys.argv
CLEAR = "--clear" in sys.argv


def herdr(*args, machine=None):
    """Run a herdr command, optionally against a remote machine."""
    prefix = ["--machine", machine] if machine else []
    r = subprocess.run(["herdr", *prefix, *args], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)["result"]
    except (json.JSONDecodeError, KeyError):
        return None


def machines():
    """The local machine first, then every enabled remote one.

    `herdr machine list` prints tab-separated rows ending in enabled/disabled.
    A disabled machine has no reachable server, so asking it for agents would
    just block until the ssh attempt gives up.
    """
    out = [None]
    r = subprocess.run(["herdr", "machine", "list"], capture_output=True, text=True)
    if r.returncode != 0:
        return out
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) >= 5 and parts[4].strip() == "enabled":
            out.append(parts[1].strip())
    return out


def acceptable(text):
    """Haiku sometimes answers the title instead of compressing it."""
    if not text or len(text) > 40:
        return False
    if "?" in text or "\n" in text.strip():
        return False
    return len(text.split()) <= MAX_WORDS + 1


def shorten_many(titles):
    """One call for every new title, not one per agent.

    Per-title calls took about ten seconds each, so six agents cost a minute
    and a few of them failed outright. Batched, it is one call and one failure
    mode, and anything that does not come back usable falls through to the
    first few words.
    """
    fallback = {t: " ".join(t.split()[:MAX_WORDS]).lower() for t in titles}
    if not titles:
        return {}
    try:
        r = subprocess.run(
            ["claude", "-p", json.dumps(titles), "--model", MODEL,
             "--append-system-prompt", SYSTEM],
            capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        return fallback
    if r.returncode != 0:
        return fallback

    text = (r.stdout or "").strip()
    start, end = text.find("["), text.rfind("]")
    if start < 0 or end < 0:
        return fallback
    try:
        out = json.loads(text[start:end + 1])
    except json.JSONDecodeError:
        return fallback
    if not isinstance(out, list) or len(out) != len(titles):
        return fallback

    result = {}
    for title, label in zip(titles, out):
        label = re.sub(r"[^\w\s#/-]", "", str(label)).strip().lower()
        result[title] = label if acceptable(label) else fallback[title]
    return result


def main():
    try:
        cache = json.loads(CACHE.read_text())
    except (OSError, json.JSONDecodeError):
        cache = {}

    # (machine, pane_id, title) for every agent anywhere, so one batched call
    # covers the whole fleet rather than one per machine.
    found = []
    for machine in machines():
        agents = herdr("agent", "list", machine=machine)
        if not agents:
            continue
        for a in agents["agents"]:
            found.append((machine, a["pane_id"],
                          (a.get("terminal_title_stripped") or "").strip()))

    if not found:
        return 1

    if CLEAR:
        for machine, pane, _ in found:
            herdr("pane", "report-metadata", pane, "--source", SOURCE,
                  "--clear-token", TOKEN, "--clear-token", REMOTE_TOKEN,
                  machine=machine)
        print("cleared")
        return 0

    wanted = [(m, p, t) for m, p, t in found
              if t and t.lower() not in STATUS_TITLES]

    misses = sorted({t for _, _, t in wanted
                     if len(t) > SHORT_ENOUGH and (FORCE or t not in cache)})
    cache.update(shorten_many(misses))

    for machine, pane, title in wanted:
        label = title.lower() if len(title) <= SHORT_ENOUGH else cache.get(title, title.lower())
        args = ["pane", "report-metadata", pane, "--source", SOURCE,
                "--token", f"{TOKEN}={label}"]
        # The sidebar has no way to show a token only when it is set, so the
        # decision is made here: local agents carry no machine token at all and
        # their row collapses to one line.
        args += ["--token", f"{REMOTE_TOKEN}={machine}"] if machine else \
                ["--clear-token", REMOTE_TOKEN]
        herdr(*args, machine=machine)

    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps(cache, indent=1, sort_keys=True))
    skipped = len(found) - len(wanted)
    print(f"{len(wanted)} agent(s), {skipped} skipped, "
          f"{len(misses)} summarised, {len(cache)} cached")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
