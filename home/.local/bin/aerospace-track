#!/usr/bin/env bash
#
# aerospace-track — spatial navigation along a single fixed track of slots.
#
#   left | right   prev / next slot, looping around the ends
#   overview       print the whole layout, marking the focused slot
#
# Slot order is defined here. The window-routing rules that put each app in its
# slot live in ~/.config/aerospace/aerospace.toml — keep the two in sync when
# you add or reorder an app.
#
# Written for bash 3.2 (what macOS ships), so no namerefs or associative arrays.

set -euo pipefail

TRACK=(1 2 3 4 5 6 7 8)
LABELS=(Desktop Calendar Slack Orca "Chrome Work" "Chrome Me" Warp "VS Code")
OVERFLOW=0

AEROSPACE="${AEROSPACE_BIN:-}"
if [[ -z $AEROSPACE ]]; then
  AEROSPACE=$(command -v aerospace) || AEROSPACE=/opt/homebrew/bin/aerospace
fi

focused() {
  "$AEROSPACE" list-workspaces --focused
}

# Index of a slot within TRACK, or failure if it is not on the track at all
# (the overflow slot, or any workspace created outside this layout).
index_of() {
  local ws=$1 i
  for ((i = 0; i < ${#TRACK[@]}; i++)); do
    if [[ ${TRACK[$i]} == "$ws" ]]; then
      echo "$i"
      return 0
    fi
  done
  return 1
}

# Move delta slots along the track, wrapping at both ends: right off VS Code
# returns to the empty desktop, left off the desktop goes to VS Code.
step() {
  local delta=$1
  local cur idx count next

  cur=$(focused)
  count=${#TRACK[@]}

  if ! idx=$(index_of "$cur"); then
    # Focused on the overflow slot — step back onto the track at the start.
    "$AEROSPACE" workspace "${TRACK[0]}"
    return 0
  fi

  # Adding count before the modulo keeps a leftward step off slot 0 positive.
  next=$(((idx + delta + count) % count))
  "$AEROSPACE" workspace "${TRACK[$next]}"
}

# AeroSpace has no overview GUI — its tray icon shows only the active workspace
# — and it parks inactive windows off-screen rather than using macOS Spaces, so
# Mission Control is no help either. This prints the whole layout instead.
WINDOW_COUNTS=""

count_for() {
  printf '%s\n' "$WINDOW_COUNTS" | awk -v w="$1" '$2 == w { print $1; hit = 1 } END { if (!hit) print 0 }'
}

overview() {
  local cur i slot label n apps out=""
  local bold dim cyan reset

  if [[ -t 1 ]]; then
    bold=$'\033[1m'; dim=$'\033[2m'; cyan=$'\033[36m'; reset=$'\033[0m'
  else
    bold=""; dim=""; cyan=""; reset=""
  fi

  cur=$(focused)
  WINDOW_COUNTS=$("$AEROSPACE" list-windows --all --format '%{workspace}' 2>/dev/null | sort | uniq -c)

  for ((i = 0; i < ${#TRACK[@]}; i++)); do
    slot=${TRACK[$i]}
    label=${LABELS[$i]}
    n=$(count_for "$slot")

    # Brackets rather than colour alone mark the focused slot, so the output
    # still reads correctly when piped, redirected, or shown by a status bar.
    if [[ $slot == "$cur" ]]; then
      out+="$(printf '%s[%s %s]%s' "$bold$cyan" "$slot" "$label" "$reset")"
    elif [[ $n -gt 0 ]]; then
      out+="$(printf ' %s%s%s %s ' "$bold" "$slot" "$reset" "$label")"
    else
      out+="$(printf ' %s%s %s%s ' "$dim" "$slot" "$label" "$reset")"
    fi
  done

  echo
  printf '  %s\n' "$out"

  n=$(count_for "$OVERFLOW")
  if [[ $n -gt 0 ]] || [[ $cur == "$OVERFLOW" ]]; then
    apps=$("$AEROSPACE" list-windows --workspace "$OVERFLOW" --format '%{app-name}' 2>/dev/null |
      sort -u | paste -sd', ' -)
    if [[ $cur == "$OVERFLOW" ]]; then
      printf '  %s[%s %s]%s\n' "$bold$cyan" "$OVERFLOW" "${apps:-empty}" "$reset"
    else
      printf '   %s%s%s %s\n' "$bold" "$OVERFLOW" "$reset" "${apps:-empty}"
    fi
  fi
  echo
}

case "${1:-}" in
  left)     step -1 ;;
  right)    step 1 ;;
  overview) overview ;;
  *)
    echo "usage: aerospace-track (left|right|overview)" >&2
    exit 2
    ;;
esac
