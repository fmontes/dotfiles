#!/usr/bin/env bash
#
# pr-open — open the focused workspace's pull request in the browser.
#
# The sidebar shows the PR number but cannot make it clickable: workspace
# metadata is display-only, and a click on the row switches workspace. This is
# the same gesture from a key instead.
#
# Usage:
#   pr-open
set -euo pipefail

usage() { awk 'NR>2 && /^#/ { sub(/^# ?/, ""); print; next } NR>2 { exit }' "$0"; }
[[ ${1:-} == "-h" || ${1:-} == "--help" ]] && { usage; exit 0; }

command -v gh >/dev/null 2>&1 || { echo "gh is not installed" >&2; exit 1; }

# HERDR_PANE_ID is set inside a pane, but a herdr keybinding runs its command
# detached without it — and `pane current` needs it too. Resolve from the list,
# which carries `focused`.
cwd=$(
  herdr pane list | HERDR_WANT="${HERDR_PANE_ID:-}" python3 -c '
import sys, json, os
panes = json.load(sys.stdin)["result"]["panes"]
want = os.environ.get("HERDR_WANT") or ""
p = next((x for x in panes if x["pane_id"] == want), None) \
    or next((x for x in panes if x.get("focused")), None)
print((p.get("foreground_cwd") or p.get("cwd") or "") if p else "")
'
) || cwd=""

[[ -d ${cwd:-} ]] || cwd=$PWD

if ! root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
  echo "Not a git repository: $cwd" >&2
  exit 1
fi

branch=$(git -C "$root" rev-parse --abbrev-ref HEAD)

if ! (cd "$root" && gh pr view --web) >/dev/null 2>&1; then
  echo "No pull request for $branch" >&2
  # A key press that silently does nothing is worse than one that says why.
  herdr notification show "No pull request" --body "$branch has none open" >/dev/null 2>&1 || true
  exit 1
fi
